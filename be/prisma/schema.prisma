generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Admin {
  id       Int    @id @default(autoincrement())
  username String @unique
  password String
  email    String @unique
}

model User {
  id         Int         @id @default(autoincrement())
  username   String      @unique
  password   String? // null for accounts created through Google
  email      String      @unique
  googleId   String?     @unique
  workplaces Workplace[]
  shifts     Shift[]
}

model Workplace {
  id     Int     @id @default(autoincrement())
  userId Int
  name   String
  wage   Decimal @db.Decimal(12, 2)
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  shifts Shift[]

  @@index([userId])
}

model Shift {
  id           Int       @id @default(autoincrement())
  userId       Int
  workplaceId  Int
  timeStart    DateTime
  timeEnd      DateTime
  break        Decimal   @default(0) @db.Decimal(3, 2)
  workingHours Decimal   @db.Decimal(5, 2)
  dailyIncome  Decimal   @db.Decimal(12, 2)
  workingDate  DateTime  @db.Date
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workplace    Workplace @relation(fields: [workplaceId], references: [id], onDelete: Cascade)

  @@index([userId, workingDate])
}
